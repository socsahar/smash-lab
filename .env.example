# ============================================
# SmashLabs Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your actual values

# --------------------------------------------
# Server Configuration
# --------------------------------------------
PORT=8000
NODE_ENV=development

# --------------------------------------------
# Supabase Database Configuration
# --------------------------------------------
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# --------------------------------------------
# Stripe Payment Processing
# --------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# --------------------------------------------
# Email Service (Resend)
# --------------------------------------------
RESEND_API_KEY=re_your_resend_api_key

EMAIL_FROM=SmashLabs <no-reply@smash-lab.com>
EMAIL_TO=Smashlab.nahariya@gmail.com

# --------------------------------------------
# EmailJS Configuration (for waiver forms)
# --------------------------------------------
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id

# --------------------------------------------
# Alternative: Gmail SMTP (if using Nodemailer)
# --------------------------------------------
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-gmail-app-password

# --------------------------------------------
# Security & Sessions
# --------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
SESSION_SECRET=your-session-secret-change-this-too

# --------------------------------------------
# Verifone Payment Gateway (GreenBox)
# --------------------------------------------
# Test environment credentials from Verifone
VERIFONE_ENTITY_ID=your_entity_id_here
VERIFONE_API_KEY=your_api_key_here
VERIFONE_USER_ID=your_user_id_here
VERIFONE_PAYMENT_CONTRACT_ID=your_payment_contract_id_here
VERIFONE_PAYMENT_CONTRACT_ID_NO_CVV=your_no_cvv_contract_id_here
VERIFONE_3DS_CONTRACT_ID=your_3ds_contract_id_here
VERIFONE_INSTALLMENTS_CONTRACT_ID=your_installments_contract_id_here
VERIFONE_HOST=https://cst.test-gsc.vfims.com
VERIFONE_CURRENCY=ILS
VERIFONE_TOKEN_SCOPE=your_token_scope_here
VERIFONE_PUBLIC_KEY_ALIAS=your_public_key_alias_here

# Production: Change VERIFONE_HOST to: https://gsc.vfims.com

# --------------------------------------------
# Application URLs
# --------------------------------------------
APP_URL=http://localhost:8000
SUCCESS_URL=http://localhost:8000/order-success.html
CANCEL_URL=http://localhost:8000/order.html

# --------------------------------------------
# Feature Flags
# --------------------------------------------
ENABLE_EMAIL_VERIFICATION=true
ENABLE_STRIPE_PAYMENTS=true
ENABLE_DEBUG_LOGGING=true
